{
  "name": "diffline-monorepo",
  "private": true,
  "description": "Diffline: review GitHub pull requests in VS Code with review agents that run on your computer.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "package": "npm run package -w apps/vscode"
  },
  "license": "MIT",
  "author": "Armin Karimi",
  "repository": {
    "type": "git",
    "url": "https://github.com/arminkarimi/diffline.git"
  }
}
